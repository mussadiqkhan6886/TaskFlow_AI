{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "strict": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "types": [
      "node",
      "@playwright/test"
    ],

    "skipLibCheck": true,

    "noEmit": true
  },

  "include": [
    "**/*.ts"
  ]
}